# Optional. Without a key, intake and translation use rule-based fallbacks.
ANTHROPIC_API_KEY=
# Model for SOS intake and alert translation.
RAHAT_MODEL=claude-opus-5-5
# Set to "off" to force rule-based fallbacks (useful for demos without network to the API).
RAHAT_LLM=on
# Comma-separated origins allowed to call the API.
RAHAT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Telegram bot token from @BotFather. Without it the bot is off and the rest of the app still runs.
TELEGRAM_BOT_TOKEN=
# Sarvam AI key for voice notes (speech-to-text) and spoken alerts (text-to-speech).
SARVAM_API_KEY=
# Seconds before an unheard zone alert is re-sent (max 3 attempts).
RAHAT_RESEND_AFTER_S=600
